{
  "name": "motion-lab-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Code-driven motion graphics: Remotion + Three.js + GSAP",
  "scripts": {
    "lvp:geometry": "python scripts/lvp-logo-geometry.py",
    "lvp:v1:gpu": "remotion render LVP-V1-Seeing out/lvp/lvp-v1-seeing.mp4 --gl=angle --concurrency=50%",
    "lvp:v2:gpu": "remotion render LVP-V2-Footprint out/lvp/lvp-v2-footprint.mp4 --gl=angle --concurrency=50%",
    "lvp:v3:gpu": "remotion render LVP-V3-Profile out/lvp/lvp-v3-profile.mp4 --gl=angle --concurrency=50%",
    "lvp:endcard": "remotion still LVP-EndCard out/lvp/endcard.png --frame=60",
    "studio": "remotion studio",
    "audio": "python scripts/soundtrack.py",
    "still": "remotion still Showreel out/still.png",
    "render": "remotion render Showreel out/showreel.mp4",
    "typecheck": "tsc --noEmit",
    "exp:audio": "python scripts/score.py src/expectancy/script.json public/expectancy-score.wav",
    "exp:publish": "node --no-warnings scripts/export-youtube.ts",
    "exp:thumbnail": "remotion still ExpectancyThumbnail publish/expectancy/thumbnail.png",
    "exp:render": "remotion render Expectancy out/expectancy.mp4",
    "render:gpu": "remotion render Showreel out/showreel.mp4 --gl=angle --concurrency=50%",
    "exp:render:gpu": "remotion render Expectancy out/expectancy.mp4 --gl=angle --concurrency=50%",
    "exp:sample": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4",
    "exp:sample:gpu": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4 --gl=angle --concurrency=50%",
    "exp:sample:clean:gpu": "remotion render Exp-lln-3d-clean out/samples/lln-3d-clean.mp4 --gl=angle --concurrency=50% --muted",
    "ap:typecheck": "tsc --noEmit",
    "ap:layout": "node scripts/activepassive-layout.mjs --rows",
    "ap:estimate": "python scripts/activepassive-sync.py estimate",
    "ap:align": "python scripts/activepassive-sync.py align",
    "ap:srt": "python scripts/activepassive-sync.py srt",
    "ap:mix": "python scripts/activepassive-sync.py mix",
    "ap:check": "python scripts/activepassive-sync.py check",
    "ap:sync": "python scripts/activepassive-sync.py all",
    "ap:stills": "node scripts/activepassive-stills.mjs out/activepassive 0.5 hookYang+30 aPush+20 pNoFill+20 cmpDiff+10 sDown+20 sFill+40 kPush+10 cVol+14 cNoHigh+14 cStuck+10 cExit+10 t1exp+16 t2go+16 t3c+14 cavBreak+14 abStill+14 abHold+14 abNo+10 lg2+14 lg4+30 chipAct+10 next+40 cover",
    "ap:prep": "node -e \"const fs=require('fs');fs.mkdirSync('D:/责苏/codex保存',{recursive:true});fs.copyFileSync('../outputs-activepassive-v3/active-passive-v3.srt','D:/责苏/codex保存/active-passive-v3.srt')\"",
    "ap:render": "remotion render ActivePassive \"D:/责苏/codex保存/active-passive-v3.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "ap:render:cpu": "remotion render ActivePassive \"D:/责苏/codex保存/active-passive-v3.mp4\" --gl=swangle --concurrency=2 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "ap:cover": "remotion still ActivePassiveCover \"D:/责苏/codex保存/active-passive-v3-cover.png\" --gl=angle",
    "ap:cover:cpu": "remotion still ActivePassiveCover \"D:/责苏/codex保存/active-passive-v3-cover.png\" --gl=swangle",
    "ap:make": "npm run ap:typecheck && npm run ap:sync && npm run ap:layout && npm run ap:prep && npm run ap:render && npm run ap:cover",
    "ap:make:cpu": "npm run ap:typecheck && npm run ap:sync && npm run ap:layout && npm run ap:prep && npm run ap:render:cpu && npm run ap:cover:cpu"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "remotion": "4.0.539",
    "three": "~0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "*",
    "@types/react": "*",
    "@types/three": "~0.186.0",
    "@types/topojson-client": "*",
    "typescript": "*"
  }
}
