 "lines": [
  {
   "id": "h1",
   "section": "hook",
   "text": "K线，只是战报。",
   "from": 9,
   "to": 62
  },
  {
   "id": "h2",
   "section": "hook",
   "text": "真正的战场，藏在它的里面。",
   "from": 74,
   "to": 160
  },
  {
   "id": "h3",
   "section": "hook",
   "text": "上场之前，先把战场看清楚。",
   "from": 174,
   "to": 259
  },
  {
   "id": "a1",
   "section": "auction",
   "text": "市场，本质上是一场永不落槌的拍卖。",
   "from": 276,
   "to": 377
  },
  {
   "id": "a2",
   "section": "auction",
   "text": "买方报出价，卖方报要价，一层层排成两堵墙。",
   "from": 390,
   "to": 522
  },
  {
   "id": "a3",
   "section": "auction",
   "text": "中间的缺口叫买卖价差，没人跨过去，就没有成交。",
   "from": 534,
   "to": 674
  },
  {
   "id": "a4",
   "section": "auction",
   "text": "很多人以为，买的人多，所以涨。",
   "from": 690,
   "to": 775
  },
  {
   "id": "a5",
   "section": "auction",
   "text": "可每一笔成交，买入量和卖出量永远相等。",
   "from": 788,
   "to": 904
  },
  {
   "id": "a6",
   "section": "auction",
   "text": "价格往哪走，不看人数，看哪一边更急。",
   "from": 918,
   "to": 1030
  },
  {
   "id": "o1",
   "section": "orders",
   "text": "这场拍卖里，有三种出手方式。",
   "from": 1047,
   "to": 1130
  },
  {
   "id": "o2",
   "section": "orders",
   "text": "第一种，被动订单，也就是限价单。它挂着等别人来成交，提供流动性。",
   "from": 1142,
   "to": 1351
  },
  {
   "id": "o3",
   "section": "orders",
   "text": "第二种，主动订单。它不等，直接吃掉对面的挂单，消耗流动性。",
   "from": 1365,
   "to": 1556
  },
  {
   "id": "o4",
   "section": "orders",
   "text": "一档的挂单被吃光，价格才跳到下一档。",
   "from": 1568,
   "to": 1675
  },
  {
   "id": "o5",
   "section": "orders",
   "text": "再吃光一档，再跳一档。这就是价格移动的最小过程。",
   "from": 1686,
   "to": 1848
  },
  {
   "id": "o6",
   "section": "orders",
   "text": "第三种，止损订单。",
   "from": 1864,
   "to": 1925
  },
  {
   "id": "s1",
   "section": "stops",
   "text": "它平时不显示在盘口，像埋好的地雷。",
   "from": 1937,
   "to": 2032
  },
  {
   "id": "s2",
   "section": "stops",
   "text": "做空的人，常把止损买单设在前高上方。",
   "from": 2044,
   "to": 2157
  },
  {
   "id": "s3",
   "section": "stops",
   "text": "价格一碰到触发价，止损就变成主动买单。",
   "from": 2169,
   "to": 2289
  },
  {
   "id": "s4",
   "section": "stops",
   "text": "一颗引爆下一颗，盘口被扫空，价格连跳几档。",
   "from": 2299,
   "to": 2432
  },
  {
   "id": "p1",
   "section": "players",
   "text": "下这些单的，不是一个庄家，而是目的不同的几类人。",
   "from": 2449,
   "to": 2587
  },
  {
   "id": "p2",
   "section": "players",
   "text": "做市商两边挂单赚价差，最怕库存堆积。",
   "from": 2600,
   "to": 2716
  },
  {
   "id": "p3",
   "section": "players",
   "text": "机构单子太大，只能拆成小单，慢慢做完。",
   "from": 2727,
   "to": 2847
  },
  {
   "id": "p4",
   "section": "players",
   "text": "套保者为了对冲风险，不太在乎这一笔的盈亏。",
   "from": 2858,
   "to": 2974
  },
  {
   "id": "p5",
   "section": "players",
   "text": "短线交易者追逐波动，止损设得最近。",
   "from": 2985,
   "to": 3087
  },
  {
   "id": "p6",
   "section": "players",
   "text": "操纵确实存在，也是违规的；但大多数日常波动，来自这些需求的碰撞。",
   "from": 3101,
   "to": 3294
  },
  {
   "id": "w2",
   "section": "anatomy",
   "text": "回头看这根K线：开高低收四个价格，过程全被压缩了。",
   "from": 3311,
   "to": 3465
  },
  {
   "id": "w3",
   "section": "anatomy",
   "text": "同样一根大阳线，可能是买方一路主动吃单。",
   "from": 3477,
   "to": 3595
  },
  {
   "id": "w4",
   "section": "anatomy",
   "text": "也可能只是止损被连环引爆，打完，买盘就没了。",
   "from": 3606,
   "to": 3744
  },
  {
   "id": "w5",
   "section": "anatomy",
   "text": "结果一样，原因不同，后面的走势也可能不同。",
   "from": 3757,
   "to": 3867
  },
  {
   "id": "r1",
   "section": "recap",
   "text": "别只问它涨没涨，要问是谁在动手，为什么动手。",
   "from": 3915,
   "to": 4043
  },
  {
   "id": "r2",
   "section": "recap",
   "text": "当然，挂单可以撤，订单流只提高概率。",
   "from": 4056,
   "to": 4169
  },
  {
   "id": "r3",
   "section": "recap",
   "text": "下一期，走进足迹图。",
   "from": 4182,
   "to": 4242
  }
 ],
