{
  "name": "motion-lab-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Code-driven motion graphics: Remotion + Three.js + GSAP",
  "scripts": {
    "lvp:geometry": "python scripts/lvp-logo-geometry.py",
    "lvp:v1:gpu": "remotion render LVP-V1-Seeing out/lvp/lvp-v1-seeing.mp4 --gl=angle --concurrency=50%",
    "lvp:v2:gpu": "remotion render LVP-V2-Footprint out/lvp/lvp-v2-footprint.mp4 --gl=angle --concurrency=50%",
    "lvp:v3:gpu": "remotion render LVP-V3-Profile out/lvp/lvp-v3-profile.mp4 --gl=angle --concurrency=50%",
    "lvp:endcard": "remotion still LVP-EndCard out/lvp/endcard.png --frame=60",
    "studio": "remotion studio",
    "audio": "python scripts/soundtrack.py",
    "still": "remotion still Showreel out/still.png",
    "render": "remotion render Showreel out/showreel.mp4",
    "typecheck": "tsc --noEmit",
    "exp:audio": "python scripts/score.py src/expectancy/script.json public/expectancy-score.wav",
    "exp:publish": "node --no-warnings scripts/export-youtube.ts",
    "exp:thumbnail": "remotion still ExpectancyThumbnail publish/expectancy/thumbnail.png",
    "exp:render": "remotion render Expectancy out/expectancy.mp4",
    "render:gpu": "remotion render Showreel out/showreel.mp4 --gl=angle --concurrency=50%",
    "exp:render:gpu": "remotion render Expectancy out/expectancy.mp4 --gl=angle --concurrency=50%",
    "exp:sample": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4",
    "exp:sample:gpu": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4 --gl=angle --concurrency=50%",
    "exp:sample:clean:gpu": "remotion render Exp-lln-3d-clean out/samples/lln-3d-clean.mp4 --gl=angle --concurrency=50% --muted",
    "fo:vo": "python scripts/fakeout-vo.py",
    "fo:audio": "python scripts/fakeout-score.py",
    "fo:srt": "python scripts/fakeout-srt.py ../outputs-v6/subtitles.srt",
    "fo:stills": "node scripts/breakout-stills.mjs FakeoutV6 out/fakeout/stills 30 100 112 150 230 330 560 790 1500 2700 2960 3060 3180 3300 3420 3600 3720 3790 3860",
    "fo:cover": "remotion still FakeoutV6Cover ../outputs-v6/cover.png",
    "fo:cover:gpu": "remotion still FakeoutV6Cover ../outputs-v6/cover.png --gl=angle",
    "fo:render": "remotion render FakeoutV6 out/fakeout/false-breakout-v6.mp4 --concurrency=1 --audio-codec=aac --audio-bitrate=320k",
    "fo:render:gpu": "remotion render FakeoutV6 out/fakeout/false-breakout-v6.mp4 --gl=angle --concurrency=50% --audio-codec=aac --audio-bitrate=320k",
    "fo:qc": "python scripts/breakout-qc.py out/fakeout/false-breakout-v6.mp4 140 160",
    "zq:render": "remotion render Zhanqian \"D:/claude视频/zhanqian-awakening-ep01-v6.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "zq:render:cpu": "remotion render Zhanqian \"D:/claude视频/zhanqian-awakening-ep01-v6.mp4\" --concurrency=1 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "zq:render:2k": "remotion render Zhanqian \"D:/claude视频/zhanqian-awakening-ep01-v6-2k.mp4\" --props=props/zhanqian-2k.json --scale=1.3333333333 --gl=angle --concurrency=50% --image-format=jpeg --jpeg-quality=95 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "zq:render:4k": "remotion render Zhanqian \"D:/claude视频/zhanqian-awakening-ep01-v6-4k.mp4\" --props=props/zhanqian-4k.json --scale=2 --gl=angle --concurrency=25% --image-format=jpeg --jpeg-quality=95 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "zq:render:draft": "remotion render Zhanqian \"D:/claude视频/zhanqian-awakening-ep01-v6-draft.mp4\" --scale=0.5 --gl=angle --concurrency=50% --crf=23",
    "zq:cover": "remotion still ZhanqianCover ../outputs-zhanqian/cover.png",
    "zq:cover:2k": "remotion still ZhanqianCover ../outputs-zhanqian/cover-2k.png --props=props/zhanqian-2k.json --scale=1.3333333333 --gl=angle",
    "zq:cover:4k": "remotion still ZhanqianCover ../outputs-zhanqian/cover-4k.png --props=props/zhanqian-4k.json --scale=2 --gl=angle",
    "zq:vo": "python scripts/zhanqian-vo.py",
    "zq:cues": "npx tsx scripts/zhanqian-cues.ts",
    "zq:audio": "npx tsx scripts/zhanqian-cues.ts && python scripts/zhanqian-score.py",
    "zq:srt": "python scripts/zhanqian-srt.py ../outputs-zhanqian/subtitles.srt",
    "zq:qc": "python scripts/breakout-qc.py \"D:/claude视频/zhanqian-awakening-ep01-v6.mp4\" 170 175",
    "zq:qc:2k": "python scripts/breakout-qc.py \"D:/claude视频/zhanqian-awakening-ep01-v6-2k.mp4\" 170 175",
    "zq:qc:4k": "python scripts/breakout-qc.py \"D:/claude视频/zhanqian-awakening-ep01-v6-4k.mp4\" 170 175",
    "zq:layout": "node scripts/zhanqian-qa.mjs 2",
    "sc:vo": "python scripts/samecandle-vo.py",
    "sc:audio": "python scripts/samecandle-score.py",
    "sc:srt": "python scripts/samecandle-srt.py",
    "sc:stills": "node scripts/breakout-stills.mjs SameCandle out/samecandle/stills 0 40 120 320 650 1060 1560 1915 2330 2500",
    "sc:prep": "node -e \"const fs=require('fs');fs.mkdirSync('D:/claude视频',{recursive:true});fs.copyFileSync('../outputs-samecandle-v1/subtitles.srt','D:/claude视频/same-candle-v1.srt')\"",
    "sc:render": "remotion render SameCandle \"D:/claude视频/same-candle-v1.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "sc:render:cpu": "remotion render SameCandle \"D:/claude视频/same-candle-v1.mp4\" --gl=swangle --concurrency=2 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "sc:cover": "remotion still SameCandleCover \"D:/claude视频/same-candle-v1-cover.png\" --gl=angle",
    "sc:cover:cpu": "remotion still SameCandleCover \"D:/claude视频/same-candle-v1-cover.png\" --gl=swangle",
    "sc:verify": "node scripts/samecandle-verify.mjs \"D:/claude视频/same-candle-v1.mp4\" \"D:/claude视频/same-candle-v1-cover.png\" 60 90",
    "sc:make": "npm run sc:prep && npm run sc:render && npm run sc:cover && npm run sc:verify",
    "sc:make:cpu": "npm run sc:prep && npm run sc:render:cpu && npm run sc:cover:cpu && npm run sc:verify"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "remotion": "4.0.539",
    "three": "~0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "*",
    "@types/react": "*",
    "@types/three": "~0.186.0",
    "@types/topojson-client": "*",
    "typescript": "*"
  }
}
