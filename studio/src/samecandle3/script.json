{
  "title": "同一根大阳线，为什么结局完全不同？",
  "voice": "zh-CN-YunxiNeural",
  "rate": "+2%",
  "pitch": "-1Hz",
  "fps": 30,
  "lead": 0.35,
  "tail": 2.4,
  "sections": [
    {
      "id": "hook",
      "lines": [
        { "id": "h1", "text": "同样一根大阳线，", "gap": 0.12 },
        { "id": "h2", "text": "有人从这里起飞，有人在这里见顶，", "gap": 0.08 },
        { "id": "h3", "text": "还有人，被原样打了回来。", "gap": 0.6 }
      ]
    },
    {
      "id": "why",
      "lines": [
        { "id": "w1", "text": "为什么？", "gap": 0.3 },
        { "id": "w2", "text": "因为大阳线只是一个结果：这段时间里，买方赢了。", "gap": 0.35 },
        { "id": "w3", "text": "它不告诉你接下来会怎样。真正决定后面的，是三件事。", "gap": 0.6 }
      ]
    },
    {
      "id": "pos",
      "lines": [
        { "id": "p1", "text": "第一，位置。", "gap": 0.3 },
        { "id": "p2", "text": "长期横盘后第一次向上突破，往往是新趋势的起点。", "gap": 0.35 },
        { "id": "p3", "text": "连涨很久之后再拉大阳，常常是最后一批买家冲了进来。", "gap": 0.35 },
        { "id": "p4", "text": "下跌途中撞上前期压力，更多是空头在回补。", "gap": 0.6 }
      ]
    },
    {
      "id": "vol",
      "lines": [
        { "id": "v1", "text": "第二，量能。", "gap": 0.3 },
        { "id": "v2", "text": "突破时放量，说明有新资金愿意在高处继续买。", "gap": 0.35 },
        { "id": "v3", "text": "高位突然爆出天量，往往意味着买盘被一次性用完了。", "gap": 0.35 },
        { "id": "v4", "text": "反弹却缩量，说明根本没多少人跟。", "gap": 0.6 }
      ]
    },
    {
      "id": "hold",
      "lines": [
        { "id": "c1", "text": "第三，也是最关键的：承接。", "gap": 0.3 },
        { "id": "c2", "text": "在这根阳线实体的一半，画一条线。", "gap": 0.35 },
        { "id": "c3", "text": "之后几根K线守在线上，买方还在掌控。", "gap": 0.3 },
        { "id": "c4", "text": "跌破一半，买方的努力就被抹掉了一大半；", "gap": 0.12 },
        { "id": "c5", "text": "跌回开盘价之下，这根大阳线就成了陷阱。", "gap": 0.65 }
      ]
    },
    {
      "id": "recap",
      "lines": [
        { "id": "r1", "text": "回到开头的三种结局。", "gap": 0.3 },
        { "id": "r2", "text": "起飞的：低位，放量，守住一半。", "gap": 0.3 },
        { "id": "r3", "text": "见顶的：高位，天量，第二天就跌破。", "gap": 0.3 },
        { "id": "r4", "text": "被打回的：压力位，缩量，没人接。", "gap": 0.7 }
      ]
    },
    {
      "id": "end",
      "lines": [
        { "id": "e1", "text": "所以，大阳线不是答案，", "gap": 0.08 },
        { "id": "e2", "text": "而是一个问题。", "gap": 0.45 },
        { "id": "e3", "text": "答案，写在它后面的K线里。", "gap": 0 }
      ]
    }
  ]
}
