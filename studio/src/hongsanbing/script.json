{
  "title": "红三兵：三根阳线，不一定是机会",
  "voice": "zh-CN-YunxiNeural",
  "rate": "-2%",
  "pitch": "-1Hz",
  "fps": 30,
  "lead": 0.25,
  "tail": 3.2,
  "sections": [
    {
      "id": "hook",
      "lines": [
        {
          "id": "h1",
          "text": "三根阳线连着涨，你敢追吗？",
          "gap": 0.15
        },
        {
          "id": "h2",
          "text": "看起来，像机会。",
          "gap": 0.18
        },
        {
          "id": "h3",
          "text": "也可能，是最后一冲。",
          "gap": 0.45
        }
      ],
      "rate": "+10%"
    },
    {
      "id": "def",
      "lines": [
        {
          "id": "d1",
          "text": "红三兵，是连续三根阳线，收盘一根比一根高。",
          "gap": 0.25
        },
        {
          "id": "d2",
          "text": "每一根的开盘，落在前一根的实体内部或附近。",
          "gap": 0.22
        },
        {
          "id": "d3",
          "text": "实体饱满，上影线相对较短。",
          "gap": 0.2
        },
        {
          "id": "d4",
          "text": "量能，最好温和放大。",
          "gap": 0.5
        }
      ],
      "rate": "+9%"
    },
    {
      "id": "weak",
      "lines": [
        {
          "id": "w1",
          "text": "但不是所有三连阳，都叫红三兵。",
          "gap": 0.25
        },
        {
          "id": "w2",
          "text": "实体越来越小，上影线越来越长，",
          "gap": 0.15
        },
        {
          "id": "w3",
          "text": "量能在萎缩，或者第三根明显冲高回落，",
          "gap": 0.2
        },
        {
          "id": "w4",
          "text": "形态质量就在减弱，不能简单当成看涨信号。",
          "gap": 0.6
        }
      ],
      "rate": "+8%"
    },
    {
      "id": "pos",
      "lines": [
        {
          "id": "p1",
          "text": "而位置，比形态更重要。",
          "gap": 0.35
        },
        {
          "id": "p2",
          "text": "低位止跌、横盘突破、趋势初期出现，参考价值更高。",
          "gap": 0.35
        },
        {
          "id": "p3",
          "text": "可如果是高位加速、远离支撑，或者逼近重要压力位，",
          "gap": 0.2
        },
        {
          "id": "p4",
          "text": "就要警惕诱多，和冲高兑现。",
          "gap": 0.7
        }
      ],
      "rate": "+3%"
    },
    {
      "id": "conf",
      "lines": [
        {
          "id": "c1",
          "text": "所以，别因为第三根很强，就直接追高。",
          "gap": 0.45
        },
        {
          "id": "c2",
          "text": "先看它能不能突破关键压力，",
          "gap": 0.3
        },
        {
          "id": "c3",
          "text": "再看回踩，守不守得住，",
          "gap": 0.3
        },
        {
          "id": "c4",
          "text": "量能，跟不跟得上。",
          "gap": 0.9
        }
      ]
    },
    {
      "id": "risk",
      "lines": [
        {
          "id": "r1",
          "text": "止损，可以参考形态的低点，",
          "gap": 0.25
        },
        {
          "id": "r2",
          "text": "或者第一根阳线的实体下沿。",
          "gap": 0.5
        },
        {
          "id": "r3",
          "text": "红三兵只是一个概率信号，",
          "gap": 0.2
        },
        {
          "id": "r4",
          "text": "不是保证上涨的公式。",
          "gap": 1.0
        }
      ]
    },
    {
      "id": "end",
      "lines": [
        {
          "id": "e1",
          "text": "形态是线索，",
          "gap": 0.35
        },
        {
          "id": "e2",
          "text": "不是答案。",
          "gap": 0.2
        }
      ]
    }
  ]
}
