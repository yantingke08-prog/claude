    "stills": "node scripts/stills.mjs",
    "render": "powershell -ExecutionPolicy Bypass -File scripts/render.ps1"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "postprocessing": "6.39.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.539",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
