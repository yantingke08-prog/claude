{
  "name": "motion-lab-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Code-driven motion graphics: Remotion + Three.js + GSAP",
  "scripts": {
    "lvp:geometry": "python scripts/lvp-logo-geometry.py",
    "lvp:v1:gpu": "remotion render LVP-V1-Seeing out/lvp/lvp-v1-seeing.mp4 --gl=angle --concurrency=50%",
    "lvp:v2:gpu": "remotion render LVP-V2-Footprint out/lvp/lvp-v2-footprint.mp4 --gl=angle --concurrency=50%",
    "lvp:v3:gpu": "remotion render LVP-V3-Profile out/lvp/lvp-v3-profile.mp4 --gl=angle --concurrency=50%",
    "lvp:endcard": "remotion still LVP-EndCard out/lvp/endcard.png --frame=60",
    "studio": "remotion studio",
    "audio": "python scripts/soundtrack.py",
    "still": "remotion still Showreel out/still.png",
    "render": "remotion render Showreel out/showreel.mp4",
    "typecheck": "tsc --noEmit",
    "exp:audio": "python scripts/score.py src/expectancy/script.json public/expectancy-score.wav",
    "exp:publish": "node --no-warnings scripts/export-youtube.ts",
    "exp:thumbnail": "remotion still ExpectancyThumbnail publish/expectancy/thumbnail.png",
    "exp:render": "remotion render Expectancy out/expectancy.mp4",
    "render:gpu": "remotion render Showreel out/showreel.mp4 --gl=angle --concurrency=50%",
    "exp:render:gpu": "remotion render Expectancy out/expectancy.mp4 --gl=angle --concurrency=50%",
    "exp:sample": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4",
    "exp:sample:gpu": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4 --gl=angle --concurrency=50%",
    "exp:sample:clean:gpu": "remotion render Exp-lln-3d-clean out/samples/lln-3d-clean.mp4 --gl=angle --concurrency=50% --muted",
    "vnr:typecheck": "tsc --noEmit",
    "vnr:tts": "python scripts/volnorise-sync.py tts",
    "vnr:estimate": "python scripts/volnorise-sync.py estimate",
    "vnr:align": "python scripts/volnorise-sync.py align",
    "vnr:srt": "python scripts/volnorise-sync.py srt",
    "vnr:mix": "python scripts/volnorise-sync.py mix",
    "vnr:check": "python scripts/volnorise-sync.py check",
    "vnr:sync": "python scripts/volnorise-sync.py all",
    "vnr:sync:local": "python scripts/volnorise-sync.py local",
    "vnr:stills": "node scripts/volnorise-stills.mjs out/volnorise 0.5 0 hQ+14 cd2+6 punch+20 wSell+30 abIn+20 abIn+40 posBFar+20 vShrink+30 cCatch+20 cShort+20 bHigher+30 bFlip+30 sBV+20 lStop+20 eCmt+10 eRisk+30 cover",
    "vnr:prep": "node -e \"const fs=require('fs');fs.mkdirSync('D:/claude视频',{recursive:true});fs.copyFileSync('../outputs-volnorise-v1/vol-no-rise-v1.srt','D:/claude视频/vol-no-rise-v1.srt')\"",
    "vnr:render": "remotion render VolNoRise \"D:/claude视频/vol-no-rise-v1.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "vnr:render:cpu": "remotion render VolNoRise \"D:/claude视频/vol-no-rise-v1.mp4\" --gl=swangle --concurrency=2 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "vnr:cover": "remotion still VolNoRiseCover \"D:/claude视频/vol-no-rise-v1-cover.png\" --gl=angle",
    "vnr:cover:cpu": "remotion still VolNoRiseCover \"D:/claude视频/vol-no-rise-v1-cover.png\" --gl=swangle",
    "vnr:make": "npm run vnr:typecheck && npm run vnr:sync && npm run vnr:prep && npm run vnr:render && npm run vnr:cover",
    "vnr:make:cpu": "npm run vnr:typecheck && npm run vnr:sync && npm run vnr:prep && npm run vnr:render:cpu && npm run vnr:cover:cpu",
    "vnr2:typecheck": "tsc --noEmit",
    "vnr2:tts": "python scripts/volnorise2-sync.py tts",
    "vnr2:estimate": "python scripts/volnorise2-sync.py estimate",
    "vnr2:align": "python scripts/volnorise2-sync.py align",
    "vnr2:srt": "python scripts/volnorise2-sync.py srt",
    "vnr2:mix": "python scripts/volnorise2-sync.py mix",
    "vnr2:check": "python scripts/volnorise2-sync.py check && node scripts/volnorise2-layout.mjs",
    "vnr2:layout": "node scripts/volnorise2-layout.mjs",
    "vnr2:sync": "python scripts/volnorise2-sync.py all",
    "vnr2:sync:local": "python scripts/volnorise2-sync.py local",
    "vnr2:stills": "node scripts/volnorise2-stills.mjs out/volnorise2 0.5 0 hQ+14 cd2+6 punch+20 tHigh+20 wVol+30 wCeil+20 wTop+20 pDiff+20 lHand+30 lDone+10 gDist+20 gSign+30 sB3+20 xStop+20 eCmt+10 eRisk+30 cover",
    "vnr2:prep": "node -e \"const fs=require('fs');fs.mkdirSync('D:/claude视频',{recursive:true});fs.copyFileSync('../outputs-volnorise-v2/vol-no-rise-v2.srt','D:/claude视频/vol-no-rise-v2.srt')\"",
    "vnr2:render": "remotion render VolNoRise2 \"D:/claude视频/vol-no-rise-v2.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "vnr2:render:cpu": "remotion render VolNoRise2 \"D:/claude视频/vol-no-rise-v2.mp4\" --gl=swangle --concurrency=2 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "vnr2:cover": "remotion still VolNoRise2Cover \"D:/claude视频/vol-no-rise-v2-cover.png\" --gl=angle",
    "vnr2:cover:cpu": "remotion still VolNoRise2Cover \"D:/claude视频/vol-no-rise-v2-cover.png\" --gl=swangle",
    "vnr2:make": "npm run vnr2:typecheck && npm run vnr2:sync && npm run vnr2:prep && npm run vnr2:render && npm run vnr2:cover",
    "vnr2:make:cpu": "npm run vnr2:typecheck && npm run vnr2:sync && npm run vnr2:prep && npm run vnr2:render:cpu && npm run vnr2:cover:cpu",
    "vnr3:typecheck": "tsc --noEmit",
    "vnr3:tts": "python scripts/volnorise3-sync.py tts",
    "vnr3:estimate": "python scripts/volnorise3-sync.py estimate",
    "vnr3:align": "python scripts/volnorise3-sync.py align",
    "vnr3:srt": "python scripts/volnorise3-sync.py srt",
    "vnr3:mix": "python scripts/volnorise3-sync.py mix",
    "vnr3:check": "python scripts/volnorise3-sync.py check && node scripts/volnorise3-layout.mjs",
    "vnr3:layout": "node scripts/volnorise3-layout.mjs",
    "vnr3:sync": "python scripts/volnorise3-sync.py all",
    "vnr3:sync:local": "python scripts/volnorise3-sync.py local",
    "vnr3:stills": "node scripts/volnorise3-stills.mjs out/volnorise3 0.5 0 hQ+14 cd2+6 punch+20 tHigh+20 wVol+30 wCeil+20 wTop+20 pDiff+20 lHand+30 lDone+10 gDist+20 gSign+30 sB3+20 xStop+20 eCmt+10 eRisk+30 cover",
    "vnr3:prep": "node -e \"const fs=require('fs');fs.mkdirSync('D:/claude视频',{recursive:true});fs.copyFileSync('../outputs-volnorise-v2/vol-no-rise-v3.srt','D:/claude视频/vol-no-rise-v3.srt')\"",
    "vnr3:render": "remotion render VolNoRise3 \"D:/claude视频/vol-no-rise-v3.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "vnr3:render:cpu": "remotion render VolNoRise3 \"D:/claude视频/vol-no-rise-v3.mp4\" --gl=swangle --concurrency=2 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "vnr3:cover": "remotion still VolNoRise3Cover \"D:/claude视频/vol-no-rise-v3-cover.png\" --gl=angle",
    "vnr3:cover:cpu": "remotion still VolNoRise3Cover \"D:/claude视频/vol-no-rise-v3-cover.png\" --gl=swangle",
    "vnr3:make": "npm run vnr3:typecheck && npm run vnr3:sync && npm run vnr3:prep && npm run vnr3:render && npm run vnr3:cover",
    "vnr3:make:cpu": "npm run vnr3:typecheck && npm run vnr3:sync && npm run vnr3:prep && npm run vnr3:render:cpu && npm run vnr3:cover:cpu"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "remotion": "4.0.539",
    "three": "~0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "*",
    "@types/react": "*",
    "@types/three": "~0.186.0",
    "@types/topojson-client": "*",
    "typescript": "*"
  }
}
