{
  "name": "heatmap-v1",
  "version": "1.0.0",
  "private": true,
  "description": "热图怎么看？挂单墙背后的真相 — vertical 1080x1920 30fps 3D Remotion explainer (no voiceover)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
