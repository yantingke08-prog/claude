{
  "name": "motion-lab-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Code-driven motion graphics: Remotion + Three.js + GSAP",
  "scripts": {
    "lvp:geometry": "python scripts/lvp-logo-geometry.py",
    "lvp:v1:gpu": "remotion render LVP-V1-Seeing out/lvp/lvp-v1-seeing.mp4 --gl=angle --concurrency=50%",
    "lvp:v2:gpu": "remotion render LVP-V2-Footprint out/lvp/lvp-v2-footprint.mp4 --gl=angle --concurrency=50%",
    "lvp:v3:gpu": "remotion render LVP-V3-Profile out/lvp/lvp-v3-profile.mp4 --gl=angle --concurrency=50%",
    "lvp:endcard": "remotion still LVP-EndCard out/lvp/endcard.png --frame=60",
    "studio": "remotion studio",
    "audio": "python scripts/soundtrack.py",
    "still": "remotion still Showreel out/still.png",
    "render": "remotion render Showreel out/showreel.mp4",
    "typecheck": "tsc --noEmit",
    "exp:audio": "python scripts/score.py src/expectancy/script.json public/expectancy-score.wav",
    "exp:publish": "node --no-warnings scripts/export-youtube.ts",
    "exp:thumbnail": "remotion still ExpectancyThumbnail publish/expectancy/thumbnail.png",
    "exp:render": "remotion render Expectancy out/expectancy.mp4",
    "render:gpu": "remotion render Showreel out/showreel.mp4 --gl=angle --concurrency=50%",
    "exp:render:gpu": "remotion render Expectancy out/expectancy.mp4 --gl=angle --concurrency=50%",
    "exp:sample": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4",
    "exp:sample:gpu": "remotion render Exp-lln-3d-sample out/samples/lln-3d-sample.mp4 --gl=angle --concurrency=50%",
    "exp:sample:clean:gpu": "remotion render Exp-lln-3d-clean out/samples/lln-3d-clean.mp4 --gl=angle --concurrency=50% --muted",
    "sh:typecheck": "tsc --noEmit",
    "sh:deps": "pip install numpy scipy faster-whisper pypinyin",
    "sh:estimate": "python scripts/stophunt-sync.py estimate",
    "sh:align": "python scripts/stophunt-sync.py align",
    "sh:srt": "python scripts/stophunt-sync.py srt",
    "sh:mix": "python scripts/stophunt-sync.py mix",
    "sh:sync": "python scripts/stophunt-sync.py all",
    "sh:stills": "node scripts/stophunt-stills.mjs out/stophunt 0.5 10 reveal+30 liqMany+16 buyTag+10 pile+30 fire+20 volume+20 counter+20 wickTag+10 visible+16 c1vol+16 pierce+20 badHit+16 goodHold+20 away+20 q2+10 cover",
    "sh:prep": "node -e \"const fs=require('fs');fs.mkdirSync('D:/claude视频',{recursive:true});fs.copyFileSync('../outputs-stophunt-v2/stop-hunt-v2.srt','D:/claude视频/stop-hunt-v2.srt')\"",
    "sh:render": "remotion render StopHunt \"D:/claude视频/stop-hunt-v2.mp4\" --gl=angle --concurrency=50% --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "sh:render:cpu": "remotion render StopHunt \"D:/claude视频/stop-hunt-v2.mp4\" --gl=swangle --concurrency=2 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=320k",
    "sh:cover": "remotion still StopHuntCover \"D:/claude视频/stop-hunt-v2-cover.png\" --gl=angle",
    "sh:cover:cpu": "remotion still StopHuntCover \"D:/claude视频/stop-hunt-v2-cover.png\" --gl=swangle",
    "sh:make": "npm run sh:typecheck && npm run sh:sync && npm run sh:prep && npm run sh:render && npm run sh:cover",
    "sh:make:cpu": "npm run sh:typecheck && npm run sh:sync && npm run sh:prep && npm run sh:render:cpu && npm run sh:cover:cpu"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "remotion": "4.0.539",
    "three": "~0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "*",
    "@types/react": "*",
    "@types/three": "~0.186.0",
    "@types/topojson-client": "*",
    "typescript": "*"
  }
}
